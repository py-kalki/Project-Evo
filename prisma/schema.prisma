generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Category {
  MUSIC
  WORKSHOP
  FOOD
  SPORTS
  KIDS
}

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  role         Role           @default(USER)
  createdAt    DateTime       @default(now())
  categories   UserCategory[]
  reminders    Reminder[]
  cards        EventCard[]
}

model Event {
  id          String      @id @default(cuid())
  title       String
  category    Category
  city        String
  startsAt    DateTime
  price       Int
  description String
  imageUrl    String
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  reminders   Reminder[]
  cards       EventCard[]

  @@index([isActive, startsAt])
  @@index([category, city])
}

model UserCategory {
  userId   String
  category Category
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

model Reminder {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}

model EventCard {
  userId   String
  eventId  String
  theme    String
  stickers String[]
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
}
